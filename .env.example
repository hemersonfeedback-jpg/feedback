MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.bfjxh5v.mongodb.net/atual-layout?retryWrites=true&w=majority
PORT=3000
BASE_URL=http://localhost:3000

# Admin user (used to create an initial admin if none exists)
ADMIN_USER=admin
ADMIN_PASS=troque_esta_senha
SESSION_SECRET=troque_esse_valor_secreto

# AWS S3 (opcional) - se preencher, uploads serão enviados ao S3
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=us-east-1

# SMTP (opcional) - para notificações por e-mail
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=seu_usuario_smtp
SMTP_PASS=sua_senha_smtp
SMTP_SECURE=false
EMAIL_TO=notificacoes@seudominio.com
EMAIL_FROM=no-reply@seudominio.com
